# syntax=docker/dockerfile:1
# Production image for GLIM (lidar-inertial SLAM) under the rig supervisor, BUILT FROM PINNED SOURCE.
# tools/fetch_upstream.py fetches GTSAM, gtsam_points, GLIM and glim_ros2 at the SHAs in glim.repos;
# the build stage compiles them headless and CPU-only (Release, no -march=native, no viewer/CUDA/
# OpenCV) into /opt/glim; the runtime stage ships that tree on BASE_IMAGE with exactly the shared
# libraries it links (derived from the binaries, not hand-listed) plus the Python supervisor.
#
#   docker build -f docker/Dockerfile.runtime -t glim:dev .
#   (or tools/build_image.sh — what `rig build` runs)
#
# Why GTSAM from source: GLIM serializes its factor graph on save, which needs GTSAM built with
# Boost serialization; the ROS-packaged gtsam is built without it (and with TBB, which GLIM's
# author recommends against). GLIM/gtsam_points are tested with GTSAM 4.3a1, pinned in glim.repos.
ARG ROS_DISTRO=lyrical
# Shared build/runtime parent. Under rig, tools/build_image.sh forwards RIG_BASE_IMAGE (fleet-ros) so
# shared ros-* packages come from literally the same layers as every other fleet image; standalone
# builds use the slim ros-core parent. The runtime loader gate below is the safety net either way.
ARG BASE_IMAGE=ros:${ROS_DISTRO}-ros-core

# Resolve the parent once and use it for BOTH stages, so GLIM compiles against the ROS ABI it runs on.
FROM ${BASE_IMAGE} AS base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
# Fleet apt policy: no recommends, and no upgrades past the parent image — the parent is the ros-*
# version authority, advanced deliberately via `rig build --no-cache` (docker build --pull). Hold the
# parent's ROS packages too: `--no-upgrade` alone does not stop the solver upgrading them for a new
# dependency; an incompatible one must fail the build so the fleet base is refreshed on purpose.
RUN printf 'APT::Install-Recommends "0";\nAPT::Install-Suggests "0";\nAPT::Get::Upgrade "false";\n' \
      > /etc/apt/apt.conf.d/99-rig-apt-policy \
 && dpkg-query -W -f='${Package} ${db:Status-Status}\n' 'ros-*' \
      | awk '$2 == "installed" {print $1}' | xargs -r apt-mark hold

# ---- toolchain ------------------------------------------------------------------------------------
FROM base AS toolchain
ARG ROS_DISTRO
# Boost components: GTSAM's (serialization filesystem thread program_options date_time timer chrono
# regex — `system` is header-only since Boost 1.69 and has no package from 1.89), gtsam_points'
# graph. METIS from the distro: GTSAM's bundled copy needs CMake < 4.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build ccache git ca-certificates \
      python3-colcon-common-extensions python3-rosdep python3-yaml \
      libboost-dev libboost-serialization-dev libboost-filesystem-dev libboost-thread-dev \
      libboost-program-options-dev libboost-date-time-dev libboost-timer-dev libboost-chrono-dev \
      libboost-regex-dev libboost-graph-dev \
      libeigen3-dev libmetis-dev libfmt-dev libspdlog-dev \
 && rm -rf /var/lib/apt/lists/* \
 && (rosdep init 2>/dev/null || true)
WORKDIR /workspace

# ---- sources --------------------------------------------------------------------------------------
FROM toolchain AS sources
COPY glim.repos /workspace/glim.repos
COPY patches /workspace/patches
COPY tools/fetch_upstream.py /workspace/tools/fetch_upstream.py
# Pinned sources, then this repo's small upstream patches (patches/<repo>/*.patch, e.g. the
# glim_ros2 TF switch); a patch that no longer applies after a pin bump fails here.
RUN python3 /workspace/tools/fetch_upstream.py /workspace/src --manifest /workspace/glim.repos \
      --patches /workspace/patches
# Only manifests feed the dependency layer: a source pin change with identical dependencies must not
# reinstall the ROS build dependencies.
RUN mkdir -p /workspace/deps/glim /workspace/deps/glim_ros \
 && cp /workspace/src/glim/package.xml /workspace/deps/glim/ \
 && cp /workspace/src/glim_ros2/package.xml /workspace/deps/glim_ros/

FROM toolchain AS build-deps
COPY --from=sources /workspace/deps /workspace/deps
# cv_bridge/image_transport serve camera extensions this image disables (BUILD_WITH_CV_BRIDGE=OFF;
# ament_auto treats absent build deps as optional), and they drag OpenCV into the image.
RUN apt-get update \
 && rosdep update --rosdistro "${ROS_DISTRO}" \
 && rosdep install --from-paths /workspace/deps --ignore-src -y --rosdistro "${ROS_DISTRO}" \
      --skip-keys "glim cv_bridge image_transport" \
 && rm -rf /workspace/deps /var/lib/apt/lists/*

# ---- build ----------------------------------------------------------------------------------------
FROM build-deps AS build
ARG ROS_DISTRO
ARG TARGETARCH
ARG BUILD_JOBS
# --no-cache does not clear BuildKit cache mounts; tools/build_image.sh sets this for clean builds.
ARG GLIM_DISABLE_CCACHE=0
ENV CCACHE_DIR=/root/.cache/ccache CCACHE_MAXSIZE=2G CCACHE_COMPILERCHECK=content
COPY --from=sources /workspace/src /workspace/src
# This repo's GLIM extension module (ext/glim_map_export: the headless PLY map export).
COPY ext /workspace/ext
# GTSAM and gtsam_points are plain CMake projects; GLIM, its ROS node and the extension build with
# colcon. All install into one prefix that the runtime stage copies whole. GTSAM's -march=native defaults ON:
# keep it OFF everywhere (a portable image, and GLIM segfaults when libraries disagree on it).
RUN --mount=type=cache,id=glim-ccache-${ROS_DISTRO}-${TARGETARCH},target=/root/.cache/ccache,sharing=locked \
    if [ "${GLIM_DISABLE_CCACHE}" = 1 ]; then export CCACHE_DISABLE=1; fi \
 && JOBS="${BUILD_JOBS:-$(nproc)}" \
 && CMAKE_COMMON=(-G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/glim \
      -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/opt/glim \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache) \
 && cmake -S /workspace/src/gtsam -B /workspace/build/gtsam "${CMAKE_COMMON[@]}" \
      -DGTSAM_BUILD_WITH_MARCH_NATIVE=OFF -DGTSAM_WITH_TBB=OFF \
      -DGTSAM_USE_SYSTEM_EIGEN=ON -DGTSAM_USE_SYSTEM_METIS=ON \
      -DGTSAM_ENABLE_BOOST_SERIALIZATION=ON -DGTSAM_BUILD_UNSTABLE=ON \
      -DGTSAM_BUILD_TESTS=OFF -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF -DGTSAM_BUILD_TIMING_ALWAYS=OFF \
      -DGTSAM_BUILD_PYTHON=OFF -DGTSAM_INSTALL_MATLAB_TOOLBOX=OFF \
 && cmake --build /workspace/build/gtsam --parallel "${JOBS}" \
 && cmake --install /workspace/build/gtsam \
 && cmake -S /workspace/src/gtsam_points -B /workspace/build/gtsam_points "${CMAKE_COMMON[@]}" \
      -DGTSAM_DIR=/opt/glim/lib/cmake/GTSAM -DGTSAM_UNSTABLE_DIR=/opt/glim/lib/cmake/GTSAM_UNSTABLE \
      -DBUILD_WITH_MARCH_NATIVE=OFF -DBUILD_WITH_CUDA=OFF -DBUILD_WITH_TBB=OFF \
      -DBUILD_WITH_OPENMP=ON -DBUILD_TESTS=OFF -DBUILD_DEMO=OFF -DBUILD_EXAMPLE=OFF -DBUILD_TOOLS=OFF \
 && cmake --build /workspace/build/gtsam_points --parallel "${JOBS}" \
 && cmake --install /workspace/build/gtsam_points \
 && source "/opt/ros/${ROS_DISTRO}/setup.bash" \
 && export MAKEFLAGS="-j${JOBS}" CMAKE_BUILD_PARALLEL_LEVEL="${JOBS}" \
 && colcon build --base-paths /workspace/src/glim /workspace/src/glim_ros2 /workspace/ext \
      --build-base /workspace/build/colcon --install-base /opt/glim --merge-install \
      --event-handlers console_direct+ \
      --cmake-args -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=/opt/glim \
        -DGTSAM_DIR=/opt/glim/lib/cmake/GTSAM -DGTSAM_UNSTABLE_DIR=/opt/glim/lib/cmake/GTSAM_UNSTABLE \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
        -DBUILD_WITH_CUDA=OFF -DBUILD_WITH_VIEWER=OFF -DBUILD_WITH_MARCH_NATIVE=OFF \
        -DBUILD_WITH_OPENCV=OFF -DBUILD_WITH_CV_BRIDGE=OFF -DBUILD_TESTING=OFF \
 && ccache --show-stats \
 && rm -rf /opt/glim/include /opt/glim/lib/cmake /opt/glim/share/*/cmake \
 && rm -f /opt/glim/lib/glim_ros/validator_node
# (validator_node is unused. glim_rosbag stays: `glim-up <config> remap` maps recorded bags
# offline with it; under the fleet-ros parent its rosbag2 libraries are already present.)
#
# Record what the runtime needs. GLIM's side comes from the binaries themselves: every shared
# library the installed tree resolves outside /opt/glim, mapped to the Debian package owning it —
# and an unresolvable one fails the build here rather than on the vehicle. The supervisor's side
# (rclpy, message types, both RMWs) comes from its package.xml via rosdep, resolved HERE so the
# runtime stage needs no rosdep at all. Plus the ros-* versions GLIM compiled against, which the
# runtime gate compares (independently cached apt layers can skew).
COPY docker/runtime_deps/package.xml /workspace/runtime_deps/package.xml
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" && source /opt/glim/setup.bash \
 && export LD_LIBRARY_PATH="/opt/glim/lib:${LD_LIBRARY_PATH:-}" \
 && { find /opt/glim -type f \( -name '*.so*' -o -perm -111 \) -print0 \
        | xargs -0 -r ldd 2>/dev/null || true; } > /tmp/ldd.txt \
 && if grep -q "not found" /tmp/ldd.txt; then \
      echo "ERROR: unresolved shared libraries in the GLIM install:"; grep "not found" /tmp/ldd.txt; exit 1; \
    fi \
 && awk '$2 == "=>" && $3 ~ /^\// {print $3}' /tmp/ldd.txt | sort -u \
      | while read -r lib; do \
          case "$lib" in /opt/glim/*) continue ;; esac; \
          real="$(readlink -f "$lib")"; \
          dpkg -S "$real" 2>/dev/null || dpkg -S "$lib" 2>/dev/null \
            || { echo "no package owns $lib ($real)" >&2; exit 1; }; \
        done | cut -d: -f1 > /tmp/runtime-packages.txt \
 && python3 -c 'import sys, xml.etree.ElementTree as t; print(" ".join(e.text for e in t.parse(sys.argv[1]).iter("exec_depend")))' \
      /workspace/runtime_deps/package.xml > /tmp/wrapper-keys.txt \
 && rosdep resolve --rosdistro "${ROS_DISTRO}" $(cat /tmp/wrapper-keys.txt) | grep -v '^#' \
      >> /tmp/runtime-packages.txt \
 && sort -u /tmp/runtime-packages.txt > /opt/glim/share/runtime-packages.txt \
 && test -s /opt/glim/share/runtime-packages.txt \
 && rm -f /tmp/ldd.txt /tmp/runtime-packages.txt /tmp/wrapper-keys.txt \
 && cp /workspace/src/upstream-sources.json /opt/glim/share/upstream-sources.json \
 && dpkg-query -W -f='${Package}\t${Version}\t${db:Status-Status}\n' 'ros-*' \
      | awk '$3 == "installed" {print $1 "\t" $2}' > /opt/glim/share/build-ros-packages.tsv

# ---- runtime --------------------------------------------------------------------------------------
FROM base AS runtime
ARG ROS_DISTRO
# Plain apt from the resolved list: no rosdep (and nothing to purge, so nothing of the parent's can
# be auto-removed). Under the fleet-ros parent most packages are present and held at its versions.
COPY --from=build /opt/glim/share/runtime-packages.txt /tmp/runtime-packages.txt
RUN apt-get update \
 && xargs -r -a /tmp/runtime-packages.txt apt-get install -y --no-install-recommends \
 && rm -rf /tmp/runtime-packages.txt /var/lib/apt/lists/*
COPY --from=build /opt/glim /opt/glim
RUN echo /opt/glim/lib > /etc/ld.so.conf.d/glim.conf && ldconfig
# Gate: the shipped tree must load against exactly this stage (see docker/check_runtime.py).
COPY docker/check_runtime.py /usr/local/lib/glim/check_runtime.py
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
 && source /opt/glim/setup.bash \
 && python3 /usr/local/lib/glim/check_runtime.py /opt/glim \
      --build-packages /opt/glim/share/build-ros-packages.tsv \
 && test -x /opt/glim/lib/glim_ros/glim_rosnode \
 && test -x /opt/glim/lib/glim_ros/glim_rosbag \
 && test -f /opt/glim/lib/libmap_export_monitor.so \
 && test -f /opt/glim/share/glim/config/config_odometry_cpu.json

COPY supervisor/glim_supervisor /opt/glim_supervisor/glim_supervisor
COPY docker/entrypoints/ros-entrypoint.sh /usr/local/bin/ros-entrypoint.sh
COPY docker/entrypoints/glim-statectl /usr/local/bin/glim-statectl
RUN chmod 0755 /usr/local/bin/ros-entrypoint.sh /usr/local/bin/glim-statectl \
 && python3 -m compileall -q /opt/glim_supervisor

# Per-commit identity, declared only here: an ARG becomes part of the cache key of every later
# RUN, so declaring it earlier would re-run the apt layers on every commit.
ARG GLIM_SERVICE_REF=unknown
ARG GLIM_SERVICE_REV=unknown
ARG GLIM_SERVICE_CREATED=""
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    PYTHONPATH=/opt/glim_supervisor \
    PYTHONUNBUFFERED=1 \
    GLIM_ROSNODE=/opt/glim/lib/glim_ros/glim_rosnode \
    GLIM_ROSBAG=/opt/glim/lib/glim_ros/glim_rosbag \
    GLIM_DEFAULTS_DIR=/opt/glim/share/glim/config \
    GLIM_SERVICE_REF=${GLIM_SERVICE_REF} \
    GLIM_SERVICE_REV=${GLIM_SERVICE_REV}
# `created` is the wrapper commit's time (reproducible), replacing the parent's inherited value;
# io.rig.rosbag2.replay is fleet-ros's player-capability claim, which this image does not make.
LABEL org.opencontainers.image.title="glim" \
      org.opencontainers.image.description="GLIM lidar-inertial SLAM as a rig autonomy service" \
      org.opencontainers.image.source="https://github.com/christomaszewski/glim-service" \
      org.opencontainers.image.version="${GLIM_SERVICE_REF}" \
      org.opencontainers.image.revision="${GLIM_SERVICE_REV}" \
      org.opencontainers.image.created="${GLIM_SERVICE_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT AND BSD-3-Clause" \
      io.rig.rosbag2.replay="0"
# Readiness, not data flow: healthy unless GLIM keeps failing (a parked standby is healthy).
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 CMD ["glim-statectl", "health"]
ENTRYPOINT ["/usr/local/bin/ros-entrypoint.sh"]
# Bare runs must mount an instance file at /etc/glim/instance.json (render it with
# tools/render_config.py --instance). The supervisor starts GLIM when the target is active.
CMD ["python3", "-m", "glim_supervisor", "serve"]
